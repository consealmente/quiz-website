{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/arcade",
      "destination": "/"
    },
    {
      "source": "/arcade/:path*",
      "destination": "/"
    },
    {
      "source": "/adventure",
      "destination": "/"
    },
    {
      "source": "/lab",
      "destination": "/"
    },
    {
      "source": "/courses",
      "destination": "/"
    },
    {
      "source": "/courses/:path*",
      "destination": "/"
    },
    {
      "source": "/review",
      "destination": "/"
    },
    {
      "source": "/flashcards",
      "destination": "/"
    },
    {
      "source": "/lessons",
      "destination": "/"
    },
    {
      "source": "/exam",
      "destination": "/"
    },
    {
      "source": "/tutor",
      "destination": "/"
    },
    {
      "source": "/analytics",
      "destination": "/"
    },
    {
      "source": "/profile",
      "destination": "/"
    },
    {
      "source": "/study-room",
      "destination": "/"
    },
    {
      "source": "/multiplayer",
      "destination": "/"
    },
    {
      "source": "/psychology",
      "destination": "/"
    },
    {
      "source": "/psychology/:path*",
      "destination": "/"
    }
  ]
}
